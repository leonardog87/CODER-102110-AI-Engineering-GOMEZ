# Aplicación
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=proyecto_coder
LANGSMITH_API_KEY=

# Proveedor OpenAI-compatible
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen2.5-coder-14b

# Proveedor Hugging Face alternativo
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=

# Persistencia
CHATBOT_DB=/app/data/chatBot.sqlite3
KNOWLEDGE_CHROMA_PERSIST_DIR=/app/knowledge_base_chroma_db

# Recuperación RAG
RAG_SEMANTIC_SEARCH_ENABLED=false
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_RETRIEVAL_TOP_K=2
KNOWLEDGE_RETRIEVAL_CANDIDATES=6
KNOWLEDGE_RELEVANCE_THRESHOLD=0.30

# Búsqueda web externa: al activarla, Tavily es primario y RAG queda como respaldo.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWED_DOMAINS=argentina.gob.ar
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CONTENT_CHARS=12000
WEB_MAX_DOWNLOAD_BYTES=1000000
WEB_SEARCH_USER_AGENT=chatBot/1.0
WEB_SYNC_LOCAL_ON_DIFFERENCE=true
WEB_SYNC_MAX_PAGES=2
WEB_SYNC_SOURCE_PATH=./knowledge_base/actualizaciones_web.md
WEB_SYNC_STATE_PATH=./data/web_sync_state.json

# Evaluaciones
LANGSMITH_TRAJECTORY_DATASET=chatBot-trajectory
TRAJECTORY_JUDGE_MODEL=
