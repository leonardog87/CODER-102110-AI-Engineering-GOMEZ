# Aplicación
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=proyecto_coder
LANGSMITH_API_KEY=

# Proveedor OpenAI-compatible
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen2.5-coder-14b

# Proveedor Hugging Face alternativo
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=

# Persistencia
AGENTE_CORPORATIVO_DB=/app/data/agente_corporativo.sqlite3
CHROMA_PERSIST_DIR=/app/manuales_complejos_chroma_db
KNOWLEDGE_CHROMA_PERSIST_DIR=/app/manuales_simples_chroma_db

# MCP remoto opcional. Sin estas URLs se utiliza stdio local.
AGENT_MCP_EMPLEADO_URL=
AGENT_MCP_ADMINISTRADOR_URL=

# Evaluaciones
LANGSMITH_TRAJECTORY_DATASET=ciudad-analitica-trajectory
TRAJECTORY_JUDGE_MODEL=
