# Aplicación
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=proyecto_coder
LANGSMITH_API_KEY=

# Proveedor OpenAI-compatible
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen2.5-coder-14b

# Proveedor Hugging Face alternativo
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=

# Persistencia
AGENTE_CORPORATIVO_DB=/app/data/agente_corporativo.sqlite3
CHROMA_PERSIST_DIR=/app/manuales_complejos_chroma_db
KNOWLEDGE_CHROMA_PERSIST_DIR=/app/manuales_simples_chroma_db

# Recuperación RAG
COMPLEX_CHUNK_SIZE=800
COMPLEX_CHUNK_OVERLAP=120
COMPLEX_RETRIEVAL_TOP_K=2
COMPLEX_RETRIEVAL_CANDIDATES=6
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_RETRIEVAL_TOP_K=2
KNOWLEDGE_RETRIEVAL_CANDIDATES=6
COMPLEX_RELEVANCE_THRESHOLD=0.15
KNOWLEDGE_RELEVANCE_THRESHOLD=0.30

# MCP remoto opcional. Sin estas URLs se utiliza stdio local.
AGENT_MCP_EMPLEADO_URL=
AGENT_MCP_ADMINISTRADOR_URL=

# Evaluaciones
LANGSMITH_TRAJECTORY_DATASET=agente-corporativo-ia-trajectory
TRAJECTORY_JUDGE_MODEL=
